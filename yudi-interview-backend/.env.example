# ============================================
# AI Interview Platform - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================
# 必需配置
# ============================================

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
# 请到 https://dashscope.console.aliyun.com/ 获取 API Key
AI_BAILIAN_API_KEY=

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yudi_interview
DB_USERNAME=postgres
DB_PASSWORD=password

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# 存储配置 (MinIO/S3)
# ============================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=interview-guide
STORAGE_REGION=us-east-1

# RustFS 知识库文件存储（未配置时复用上面的 STORAGE_*）
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_BUCKET=knowledge-docs

# ============================================
# CORS 配置 - 前端地址
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ============================================
# AI 模型配置
# ============================================
# 默认模型
AI_MODEL=qwen3.5-flash
AI_DEFAULT_PROVIDER=dashscope
AI_DEFAULT_EMBEDDING_PROVIDER=dashscope
AI_EMBEDDING_DIMENSIONS=1024

# DashScope Provider
AI_PROVIDER_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_PROVIDER_DASHSCOPE_MODEL=qwen3.5-flash
AI_PROVIDER_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
AI_PROVIDER_DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# 知识库文档处理与检索（向量维度复用上面的 1024 配置）
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SIMILARITY_THRESHOLD=0.7

# LM Studio Provider (本地部署)
AI_PROVIDER_LMSTUDIO_BASE_URL=http://localhost:1234
PROVIDER_LMSTUDIO_API_KEY=lm-studio
AI_PROVIDER_LMSTUDIO_MODEL=qwen2.5-7b-instruct

# Kimi Provider
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-latest

# DeepSeek Provider
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# GLM Provider
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# ============================================
# 应用配置
# ============================================
APP_DEBUG=false
APP_UPLOAD_DIR=/tmp/ai-interview/uploads
APP_INTERVIEW_FOLLOW_UP_COUNT=1
APP_INTERVIEW_EVALUATION_BATCH_SIZE=8
APP_INTERVIEW_QUESTION_GENERATION_TIMEOUT_SECONDS=90
APP_INTERVIEW_EVALUATION_BATCH_RETRY_COUNT=2
APP_INTERVIEW_EVALUATION_STRATEGY=batch
APP_INTERVIEW_EVALUATION_QUESTION_TIMEOUT_SECONDS=60
APP_INTERVIEW_EVALUATION_QUESTION_RETRY_COUNT=2
APP_INTERVIEW_EVALUATION_QUESTION_CONCURRENCY=8
APP_INTERVIEW_EVALUATION_QUESTION_REFERENCE_MAX_CHARS=1800
APP_INTERVIEW_EVALUATION_SSE_HEARTBEAT_SECONDS=15
APP_INTERVIEW_EVALUATION_SUMMARY_TIMEOUT_SECONDS=60
# 批量备用策略配置，通过 APP_INTERVIEW_EVALUATION_STRATEGY=batch 启用
EVAL_SINGLE_TIMEOUT=95
EVAL_BATCH_TIMEOUT=200
EVAL_RETRY_BACKOFF_SECONDS=2
EVAL_BATCH_TIMEOUT_BUFFER_SECONDS=5
EVAL_SPLIT_FALLBACK_ENABLED=true
LLM_HTTP_TIMEOUT=30
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=300
LLM_WRITE_TIMEOUT=10
LLM_POOL_TIMEOUT=5
LLM_EVENT_LOOP_WATCHDOG_INTERVAL_SECONDS=0.5
LLM_EVENT_LOOP_LAG_WARNING_MS=200

# ============================================
# 语音面试配置
# ============================================

# TTS 默认音色
APP_VOICE_TTS_DEFAULT_VOICE=siyue

# ASR 配置
APP_VOICE_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
APP_VOICE_ASR_MODEL=qwen3-asr-flash-realtime
APP_VOICE_ASR_LANGUAGE=zh
APP_VOICE_ASR_FORMAT=pcm
APP_VOICE_ASR_SAMPLE_RATE=16000
APP_VOICE_ASR_ENABLE_TURN_DETECTION=true
APP_VOICE_ASR_TURN_DETECTION_TYPE=server_vad
# 与 Java 版本一致的 VAD 阈值
APP_VOICE_ASR_TURN_DETECTION_THRESHOLD=0.0
# 与 Java 版本一致，避免中文思考停顿造成句中切分
APP_VOICE_ASR_SILENCE_MS=2000
# 前端音频分片时长（毫秒）
APP_VOICE_ASR_CHUNK_MS=200

# TTS 配置
APP_VOICE_TTS_MODEL=qwen3-tts-flash-realtime
APP_VOICE_TTS_VOICE=Cherry
APP_VOICE_TTS_FORMAT=pcm
APP_VOICE_TTS_SAMPLE_RATE=24000
APP_VOICE_TTS_MODE=commit
APP_VOICE_TTS_LANGUAGE_TYPE=Chinese
APP_VOICE_TTS_SPEECH_RATE=1.0
APP_VOICE_TTS_VOLUME=60
# TTS 最大重试次数（网络异常时自动重试）
APP_VOICE_TTS_MAX_RETRIES=3

# 运行时控制
APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=2500
APP_VOICE_MIN_SILENCE_BEFORE_COMMIT_MS=2500
APP_VOICE_MIN_COMMIT_CHARS=20
APP_VOICE_MAX_WAIT_FOR_CONTINUATION_MS=7000
APP_VOICE_AI_QUESTION_MAX_CHARS=120
APP_VOICE_CHUNKED_AUDIO_ENABLED=true
APP_VOICE_TTS_TIMEOUT_SECONDS=8
APP_VOICE_OPENING_AUDIO_WARMUP_ENABLED=false
APP_VOICE_TTS_POOL_IDLE_TIMEOUT_SECONDS=300
APP_VOICE_MAX_CONCURRENT_TTS_PER_SESSION=3

# 速率限制
APP_VOICE_RATE_LIMIT_MAX_PER_SESSION=10
APP_VOICE_RATE_LIMIT_MAX_PER_IP=3
APP_VOICE_RATE_LIMIT_MAX_CONCURRENT=50

# 音频规格
APP_VOICE_AUDIO_CODEC=opus
APP_VOICE_AUDIO_SAMPLE_RATE=16000
APP_VOICE_AUDIO_BIT_RATE=24000
APP_VOICE_AUDIO_CHANNELS=1
APP_VOICE_AUDIO_CHUNK_DURATION=2000

# 面试阶段时长配置
APP_VOICE_PHASE_INTRO_MIN_DURATION=3
APP_VOICE_PHASE_INTRO_SUGGESTED_DURATION=5
APP_VOICE_PHASE_INTRO_MAX_DURATION=8
APP_VOICE_PHASE_INTRO_MIN_QUESTIONS=2
APP_VOICE_PHASE_INTRO_MAX_QUESTIONS=5

APP_VOICE_PHASE_TECH_MIN_DURATION=8
APP_VOICE_PHASE_TECH_SUGGESTED_DURATION=10
APP_VOICE_PHASE_TECH_MAX_DURATION=15
APP_VOICE_PHASE_TECH_MIN_QUESTIONS=3
APP_VOICE_PHASE_TECH_MAX_QUESTIONS=8

APP_VOICE_PHASE_PROJECT_MIN_DURATION=8
APP_VOICE_PHASE_PROJECT_SUGGESTED_DURATION=10
APP_VOICE_PHASE_PROJECT_MAX_DURATION=15
APP_VOICE_PHASE_PROJECT_MIN_QUESTIONS=2
APP_VOICE_PHASE_PROJECT_MAX_QUESTIONS=5

APP_VOICE_PHASE_HR_MIN_DURATION=3
APP_VOICE_PHASE_HR_SUGGESTED_DURATION=5
APP_VOICE_PHASE_HR_MAX_DURATION=8
APP_VOICE_PHASE_HR_MIN_QUESTIONS=2
APP_VOICE_PHASE_HR_MAX_QUESTIONS=5

# ============================================
# 结构化输出配置（Structured Output）
# ============================================
APP_AI_STRUCTURED_MAX_ATTEMPTS=2
APP_AI_STRUCTURED_INCLUDE_LAST_ERROR=true
APP_AI_STRUCTURED_RETRY_USE_REPAIR_PROMPT=true
APP_AI_STRUCTURED_RETRY_APPEND_STRICT_JSON_INSTRUCTION=true
APP_AI_STRUCTURED_ERROR_MESSAGE_MAX_LENGTH=200
APP_AI_STRUCTURED_METRICS_ENABLED=true
AI_PROMPT_SANITIZER_ENABLED=true
