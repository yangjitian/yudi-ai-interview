# ============================================
# AI Interview Platform - 前端环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================
# API 配置
# ============================================

# 后端 API 地址
VITE_API_BASE_URL=http://localhost:8000
VITE_EVALUATION_ESTIMATE_MIN_MINUTES=3
VITE_EVALUATION_ESTIMATE_MAX_MINUTES=4

# 开发服务器端口 (可选，默认 5173)
VITE_PORT=5173

# ============================================
# 可选配置
# ============================================

# WebSocket 基础地址（可选，默认使用 API_BASE_URL）
# VITE_WS_BASE_URL=ws://localhost:8000
